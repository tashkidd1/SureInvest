{
  "name": "Notification",
  "description": "In-app notifications for a user.",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "body": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "info",
        "success",
        "warning",
        "trade",
        "goal",
        "dividend"
      ],
      "default": "info"
    },
    "read": {
      "type": "boolean",
      "default": false
    },
    "icon": {
      "type": "string",
      "default": "Bell"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}

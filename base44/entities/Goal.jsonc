{
  "name": "Goal",
  "description": "A goal-based investing target for a user. account_type separates the user's Demo (virtual simulation) and Real account spaces.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 50,
      "description": "e.g. Home Deposit, Retirement \u2014 capped at 50 characters"
    },
    "description": {
      "type": "string"
    },
    "icon": {
      "type": "string",
      "description": "lucide icon name",
      "default": "Target"
    },
    "target_amount": {
      "type": "number",
      "minimum": 0
    },
    "current_amount": {
      "type": "number",
      "default": 0
    },
    "target_date": {
      "type": "string",
      "format": "date"
    },
    "category": {
      "type": "string",
      "enum": [
        "retirement",
        "education",
        "home",
        "emergency",
        "wealth",
        "other"
      ],
      "default": "wealth"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "completed",
        "paused"
      ],
      "default": "active"
    },
    "color": {
      "type": "string",
      "default": "primary"
    },
    "linked_tickers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "account_type": {
      "type": "string",
      "enum": [
        "demo",
        "real"
      ],
      "default": "demo",
      "description": "Account space this goal belongs to: demo (virtual simulation) or real (empty real-account space)"
    }
  },
  "required": [
    "name",
    "target_amount"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}

# Frontend (Vite)
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Edge Function secrets (supabase secrets set ... / .env.local for local serve)
TWELVE_DATA_API_KEY=
MANSA_API_KEY=
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=https://api.openai.com/v1

# Required for scheduled functions (dailySnapshot, executeRecurringInvestment,
# refreshMarketData). Cron / external scheduler must send:
#   Authorization: Bearer <CRON_SECRET>
# Anonymous invocation is rejected.
CRON_SECRET=
# Optional alias accepted by the same gate:
# SCHEDULER_SECRET=

# --- Frontend (Vite reads these, must be prefixed VITE_) ---
# From `supabase start` output for local dev, or Project Settings > API for cloud.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# --- Edge Functions (set with `supabase secrets set`, NOT read by Vite) ---
# Local dev: supabase start already provides SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY automatically to `supabase functions serve` — you
# only need to set the ones below.

# Your own Twelve Data key (global market quotes + USD/BWP FX).
TWELVE_DATA_API_KEY=

# Optional: Mansa API key (BSE snapshot). Leave unset to skip BSE refresh.
MANSA_API_KEY=

# investAssistant — pick one provider.
# LLM_PROVIDER=openai (default) or anthropic
LLM_PROVIDER=openai
LLM_API_KEY=
# LLM_MODEL=gpt-4o-mini (openai default) or claude-3-5-haiku-latest (anthropic default)
